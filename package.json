{
  "name": "aes512",
  "version": "2.0.4",
  "description": "Authenticated AES-256-GCM encryption toolkit for Node.js — keys, strings, files (streaming) and hashing. Outil de chiffrement authentifié AES-256-GCM pour Node.js.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "npm run build && node examples/basic.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "aes",
    "aes-256",
    "aes-256-gcm",
    "gcm",
    "encryption",
    "decrypt",
    "crypto",
    "streaming",
    "authenticated-encryption"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphaleadership/nmod.git"
  },
  "bugs": {
    "url": "https://github.com/alphaleadership/nmod/issues"
  },
  "homepage": "https://github.com/alphaleadership/nmod#readme"
}
